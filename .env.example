# LiveKit credentials — override values in config.yaml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Gemma 4 model path — set automatically by setup_models.sh
# Override if you put the .litertlm file somewhere else
GEMMA_MODEL_PATH=./models/gemma-4-e2b/gemma-4-E2B-it.litertlm

# Hugging Face token — needed to download gated Gemma 4 weights
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# Optional: GPU flags
TTS_GPU=0
STT_DEVICE=cpu
